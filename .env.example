# Runtime
EVALFORGE_ENVIRONMENT=development
EVALFORGE_LOG_LEVEL=INFO
EVALFORGE_RUNS_DIRECTORY=runs

# Target system
EVALFORGE_TARGET_URL=https://simple-safe-talk.lovable.app/api/public/chat
EVALFORGE_TARGET_TIMEOUT_SECONDS=30
EVALFORGE_TARGET_MAX_RETRIES=2
EVALFORGE_TARGET_MAX_CONCURRENCY=5

# Run limits
EVALFORGE_MAX_ITERATIONS=3
EVALFORGE_MAX_TESTS_PER_RUN=100
EVALFORGE_TARGET_PASS_RATE=0.90

# LLM provider
EVALFORGE_LLM_MODEL=
EVALFORGE_LLM_API_KEY=

# Langfuse
EVALFORGE_LANGFUSE_HOST=https://cloud.langfuse.com
EVALFORGE_LANGFUSE_PUBLIC_KEY=
EVALFORGE_LANGFUSE_SECRET_KEY=

